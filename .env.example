# Copy to OnCall/.env. Only this project file is loaded (no parent search or
# variable interpolation); process environment overrides it. Never commit .env.
ONCALL_MODE=sandbox
ONCALL_HOST=127.0.0.1
ONCALL_PORT=8200
ONCALL_MCP_PORT=8000
ONCALL_TARGET_PORT=8100
# Optional overrides; otherwise derived from the ports above, always loopback.
ONCALL_MCP_URL=
ONCALL_TARGET_URL=
# Empty selects data/demo.db in sandbox, data/live.db in live. ops.db is rejected.
ONCALL_DB_PATH=
# Single allowed service; also GitHub deployment environment and metrics/log label.
ONCALL_SERVICE=payments

# Required in live AND for any non-loopback bind (including Docker).
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 32 characters; placeholders/repeated strings rejected. Single-operator
# shared bearer key, NOT multi-user OAuth. Send via Authorization: Bearer only.
ONCALL_API_KEY=

# LIVE READ INTEGRATIONS: live startup requires both repo and Prometheus URL.
# Never enables fake data if missing/unreachable. All endpoints must use HTTPS,
# except HTTP to literal loopback/localhost. No URL credentials/query/fragment.
ONCALL_REPO=
# GitHub token optional for public repo, required for private. Least privilege:
# repository contents:read, actions:read, deployments:read. No mutation scope.
GITHUB_TOKEN=
# Base URL, e.g. https://metrics.your-company.example (not /api/v1).
PROMETHEUS_URL=
PROMETHEUS_TOKEN=
# Counter schema: http_requests_total{service="payments",status="200"},
# http_requests_total{service="payments",status="500"}. Initialize 5xx counters
# to zero; missing 5xx telemetry is UNKNOWN, never silently assumed healthy.
# 2-minute increase buckets, 5xx/total; counts are Prometheus estimates.
# Scrape interval should be <=30s; low traffic/missing/stale data stays unknown.
ONCALL_PROMETHEUS_METRIC=http_requests_total
ONCALL_TELEMETRY_MAX_AGE_SECONDS=120
# GitHub deployments must use environment=ONCALL_SERVICE, immutable commit SHA,
# and status events. Latest status=success is active; inactive/failure/unknown is
# not active. Deployment pipeline must emit inactive events for superseded work.
# Listing is bounded to 20 recent deployments, with truncation reported.

# Optional Loki base URL; absent returns explicit unavailable, not empty success.
# LogQL is restricted to configured service plus an escaped literal line filter.
LOKI_URL=
LOKI_TOKEN=

# LIVE MUTATION IS OFF until explicitly enabled and both webhook fields supplied.
ONCALL_MUTATION_ENABLED=false
ONCALL_ROLLBACK_URL=
ONCALL_ROLLBACK_TOKEN=
# Contract: POST {service,target_commit,action_id}, Authorization: Bearer <token>,
# Idempotency-Key: <action_id>. Webhook must durably deduplicate IDs, enforce the
# service allowlist, authenticate, and reconcile deployment state. target_commit
# is the exact reviewed commit; agree rollback semantics with the operator.
# Only HTTP 200/201 + JSON {"status":"success"} or {"status":"rolled_back"}
# acknowledges completion. Async/pending/empty/error/timeout => UNKNOWN. No
# automatic retry; operator reconciles uncertain actions before any new approval.

# OPTIONAL advisory Bedrock Converse routing. Disabled while model ID is empty.
# Uses boto3 installed by requirements; requires owner-authorized model access.
# Only status/logs/rollback/repo/verify/help; no tools or confirmation intent.
# Missing credentials/access or invalid output => explicit deterministic fallback.
# Enabling causes paid AWS requests during non-confirmation command routing.
# Amazon Nova Pro (cross-region inference profile) works with the tool-use loop:
#   ONCALL_BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
ONCALL_BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
AWS_PROFILE=
# Use workload IAM credentials (bedrock:InvokeModel on only your selected model)
# or an existing local AWS profile. Never bake AWS keys into the Docker image.

# LIVE METRICS SOURCE: prometheus (default) or cloudwatch. CloudWatch reads two
# Sum metrics in 2-minute periods with one dimension service=ONCALL_SERVICE.
# Publish the 5xx metric as 0 for every period with traffic; missing = UNKNOWN.
# IAM: cloudwatch:GetMetricData only. Each read is a paid GetMetricData call.
ONCALL_METRICS_SOURCE=prometheus
ONCALL_CLOUDWATCH_NAMESPACE=
ONCALL_CLOUDWATCH_REQUESTS_METRIC=Requests
ONCALL_CLOUDWATCH_ERRORS_METRIC=Errors5xx

# ALERT INTAKE: point Alertmanager (or an EventBridge/SNS relay) at
#   POST <oncall>/api/alerts   Authorization: Bearer <ONCALL_API_KEY>
# Alertmanager shape; labels.service must equal ONCALL_SERVICE. Deduplicated by
# fingerprint. A "resolved" alert never resolves the incident (verify does).

# OUTBOUND PAGING (optional). Setting a URL authorizes sending title, short
# detail and ONCALL_PUBLIC_URL to it. Formats: json | slack | ntfy. One attempt,
# no retry. A page is not consent; approval still needs the workspace control.
ONCALL_NOTIFY_URL=
ONCALL_NOTIFY_TOKEN=
ONCALL_NOTIFY_FORMAT=json
ONCALL_PUBLIC_URL=
# Re-page when still unacknowledged after N minutes on the next alert (0 = off).
ONCALL_RENOTIFY_MINUTES=5
# A background task (every 30 s) re-pages the primary while the incident is
# unacknowledged, never more often than ONCALL_RENOTIFY_MINUTES. After
# ONCALL_ESCALATION_MINUTES (1-120) unacknowledged it pages the secondary once
# (HTTPS only, same format). Acknowledging stops re-pages and escalation.
ONCALL_ESCALATION_MINUTES=10
ONCALL_SECONDARY_NOTIFY_URL=
ONCALL_SECONDARY_NOTIFY_TOKEN=
# Quiet hours (local server time, HH-HH, may wrap midnight, e.g. 23-07). Pages are
# NEVER suppressed (an outage always pages); the wording is marked URGENT instead.
ONCALL_QUIET_HOURS=

# Blast radius estimate: failed checkouts x average order value (USD). 0 = not
# configured, so no revenue figure is shown. Always labelled an estimate.
ONCALL_AVG_ORDER_VALUE=0

# Demo controls. Sandbox: always available. Live: off unless true; then
# POST /api/demo/start ships ONCALL_DEMO_BAD_COMMIT and /api/demo/reset rolls
# forward to ONCALL_DEMO_GOOD_COMMIT through the release controller's
# authenticated /deploy (rollback token; RELEASES_DEPLOY_ALLOWLIST on the
# controller can restrict it further). Both are rate limited.
ONCALL_DEMO_CONTROLS=false
ONCALL_DEMO_GOOD_COMMIT=3f9a1c2e7b4d
ONCALL_DEMO_BAD_COMMIT=8c2d5e91a0f3

# Sandbox recovery watch window: 0, 10, 30, 60 or 120 seconds. Fresh probes
# every 10s; every batch must be healthy before the incident resolves.
ONCALL_VERIFY_WATCH_SECONDS=30

# BEDROCK INVESTIGATION (ONCALL_BEDROCK_MODEL_ID above) now also drives a bounded
# tool-use loop (6 turns / 8 tool calls / 60s) over read-only tools plus
# propose_action. No mutation tool is exposed. IAM: bedrock:InvokeModel.

# DEPLOYMENT: docker compose up --build (requires generated ONCALL_API_KEY above).
# Compose publishes ONLY 127.0.0.1:8200. MCP/target remain container-internal.
# For remote users put a trusted HTTPS reverse proxy in front of localhost:8200;
# preserve Authorization, disable proxy buffering for streaming, enforce TLS,
# firewall access, and never publish the sandbox target or Docker socket.
# Back up persistent data with SQLite's backup API (or stop app before copying).
# Keep backups/access to .env private; test restores. This is a single-instance
# SQLite deployment, not a multi-tenant/high-availability production guarantee.

# OAUTH (Alexa+ account linking). Requires ONCALL_API_KEY and an HTTPS ONCALL_PUBLIC_URL.
# Alexa+ needs a static client: set all three below. Redirect URIs are the exact list
# `alexa-ai configure-account-linking` prints. See deploy/README.md "Connect Alexa+".
ONCALL_OAUTH_ENABLED=false
ONCALL_OAUTH_CLIENT_ID=
ONCALL_OAUTH_CLIENT_SECRET=
ONCALL_OAUTH_REDIRECT_URIS=
# ONCALL_OAUTH_REDIRECT_HOSTS=alexa.amazon.com,pitangui.amazon.com,layla.amazon.com,alexa.amazon.co.jp
